---
import type { SupportedLanguage } from '../i18n/ui';
import { languages, defaultLang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLanguage;
  image?: string;
  article?: boolean;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = 'The Vintage Press — Free Vintage Newspaper Clipping Generator',
  description = 'Create authentic 1920s vintage newspaper clippings in seconds. Halftone photos, aged paper textures, torn edges, Linotype layouts, and high-res 4K export with zero server tracking.',
  lang = 'en',
  image = '/og-image.png',
  article = false,
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://newspaper-clipping-generator.example.com').replace(/\/$/, '');
const currentPath = Astro.url.pathname;

// Strip any active language sub-path to obtain the canonical base path
// Examples: '/pt-br/templates' -> '/templates', '/zh/' -> '/', '/' -> '/'
const pathWithoutLang = currentPath.replace(/^\/(?:zh|pt-br|ru|ja|tr|ko)(?:\/|$)/, '/');
const cleanSubpath = pathWithoutLang === '/' ? '' : pathWithoutLang;

// Construct dynamic alternate links for international technical SEO
const alternateLinks = Object.entries(languages).map(([key, config]) => {
  const localizedPath = config.subpath
    ? `/${config.subpath}${cleanSubpath ? cleanSubpath : '/'}`
    : `${cleanSubpath || '/'}`;
  return {
    langKey: key,
    hreflang: config.hreflang,
    href: `${siteUrl}${localizedPath}`,
  };
});

const defaultUrl = `${siteUrl}${cleanSubpath || '/'}`;
const canonicalUrl = new URL(currentPath, siteUrl).toString();
const currentLangConfig = languages[lang] || languages[defaultLang];
const formattedTitle = title.includes('The Vintage Press') ? title : `${title} | The Vintage Press`;
---

<!doctype html>
<html lang={lang} dir={currentLangConfig.dir || 'ltr'}>
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Technical SEO: Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Technical SEO: Dynamic Hreflang Tags for all 7 Supported Locales -->
    {alternateLinks.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <!-- x-default points to default English route -->
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- Primary Metadata -->
    <title>{formattedTitle}</title>
    <meta name="title" content={formattedTitle} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#9fe870" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl).toString()} />
    <meta property="og:locale" content={lang} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={formattedTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl).toString()} />

    <!-- Typography: Inter for Sub-display & Body; Fallbacks for Wise Display 900 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Client-side Locale Detection & Auto-redirect for root visitors -->
    <script src="../utils/langDetect.ts"></script>

    <!-- Schema.org JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": article ? "Article" : "WebApplication",
      "name": formattedTitle,
      "description": description,
      "url": canonicalUrl,
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "inLanguage": lang,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />

    <!-- Slot for Page-Specific SEO & Schema Injection (e.g. FAQ Schema) -->
    <slot name="head" />
  </head>

  <body class="bg-canvas-soft text-ink font-body min-h-screen flex flex-col antialiased">
    {!hideHeader && (
      <header class="sticky top-0 z-40 bg-white border-b border-black/10 transition-colors">
        <div class="max-w-[1240px] mx-auto px-6 h-16 flex items-center justify-between">
          <a href={lang === defaultLang ? '/' : `/${languages[lang]?.subpath || lang}/`} class="flex items-center gap-3 group">
            <div class="w-8 h-8 rounded-xl bg-primary flex items-center justify-center font-black text-ink text-sm shadow-sm transition-transform group-hover:scale-105">
              VP
            </div>
            <span class="font-extrabold text-lg tracking-tight text-ink font-display">
              The Vintage Press
            </span>
          </a>

          <!-- Desktop Navigation Items -->
          <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-ink">
            <a href={lang === defaultLang ? '/' : `/${languages[lang]?.subpath || lang}/`} class="hover:text-black/70 transition-colors">
              Home
            </a>
            <a href="#studio" class="hover:text-black/70 transition-colors">
              Generator Studio
            </a>
            <a href={lang === defaultLang ? '/templates' : `/${languages[lang]?.subpath || lang}/templates`} class="hover:text-black/70 transition-colors">
              Templates
            </a>
            <a href={lang === defaultLang ? '/blog' : `/${languages[lang]?.subpath || lang}/blog`} class="hover:text-black/70 transition-colors">
              Blog
            </a>
            <a href={lang === defaultLang ? '/about' : `/${languages[lang]?.subpath || lang}/about`} class="hover:text-black/70 transition-colors">
              About
            </a>
          </nav>

          <!-- Right Side CTA: Signature Wise Lime-Green 24px Pill Button -->
          <div class="flex items-center gap-3">
            <a
              href="#studio"
              class="hidden sm:inline-flex items-center justify-center h-12 px-6 rounded-xl bg-primary hover:bg-primary-active text-ink font-semibold text-base transition-all duration-150 transform hover:-translate-y-0.5"
            >
              Create Clipping
            </a>
          </div>
        </div>
      </header>
    )}

    <!-- Main Content Area -->
    <main class="flex-1">
      <slot />
    </main>

    {!hideFooter && (
      <footer class="bg-ink text-canvas-soft py-12 px-6 mt-auto">
        <div class="max-w-[1240px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-mute">
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 rounded-lg bg-primary flex items-center justify-center font-bold text-ink text-xs">
              VP
            </div>
            <span class="text-canvas-soft font-semibold font-display">The Vintage Press</span>
            <span>• 100% Client-Side & Lifetime Free</span>
          </div>
          <p class="text-xs text-mute">
            Designed with Scandinavian fintech precision. No backend, no cookies, no tracking.
          </p>
        </div>
      </footer>
    )}
  </body>
</html>

<style is:global>
  /* Core Design Tokens & UI Styles from DESIGN.md */
  :root {
    --colors-primary: #9fe870;
    --colors-primary-active: #cdffad;
    --colors-primary-neutral: #c5edab;
    --colors-primary-pale: #e2f6d5;
    --colors-on-primary: #0e0f0c;

    --colors-canvas: #ffffff;
    --colors-canvas-soft: #e8ebe6;

    --colors-ink: #0e0f0c;
    --colors-ink-deep: #163300;
    --colors-body: #454745;
    --colors-mute: #868685;

    --colors-positive: #2ead4b;
    --colors-positive-deep: #054d28;
    --colors-warning: #ffd11a;
    --colors-warning-deep: #b86700;
    --colors-warning-content: #4a3b1c;
    --colors-negative: #d03238;
    --colors-negative-deep: #a72027;
    --colors-negative-darkest: #a7000d;
    --colors-negative-bg: #320707;

    --colors-accent-orange: #ffc091;
    --colors-accent-cyan: #38c8ff;

    --rounded-xl: 24px;
    --rounded-pill: 9999px;
  }

  /* Canonical Primary CTA Pill (DESIGN.md) */
  .btn-primary {
    background-color: var(--colors-primary);
    color: var(--colors-on-primary);
    border-radius: var(--rounded-xl);
    font-weight: 600;
    padding: 12px 24px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .btn-primary:hover {
    background-color: var(--colors-primary-active);
    transform: translateY(-1px);
  }

  /* Sage Canvas Hero Band (DESIGN.md) */
  .hero-band {
    background-color: var(--colors-canvas-soft);
    color: var(--colors-ink);
    padding: 48px 24px;
  }

  /* Canonical White Content Card (DESIGN.md) */
  .card-content {
    background-color: var(--colors-canvas);
    color: var(--colors-ink);
    border-radius: var(--rounded-xl);
    padding: 24px;
  }
</style>
