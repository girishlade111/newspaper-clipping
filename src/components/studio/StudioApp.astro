---
import StudioIsland from './StudioIsland';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang: SupportedLanguage;
  initialPresetId?: string;
}

const { lang, initialPresetId = 'times-of-india' } = Astro.props;
---

<StudioIsland client:load lang={lang} initialTemplate={initialPresetId} />
