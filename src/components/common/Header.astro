---
import { useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
---

<header class="navbar-wrapper">
  <div class="container">
    <div class="navbar-inner">
      <!-- Brand Logo -->
      <a href={getRelativeLocaleUrl(lang, '')} class="brand-logo">
        <div class="logo-badge">
          <span class="logo-icon">📰</span>
        </div>
        <div class="logo-text">
          <span class="logo-title">The Vintage Press</span>
          <span class="logo-sub">Clipping Studio</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="nav-links">
        <a 
          href={getRelativeLocaleUrl(lang, '')} 
          class={`nav-link ${pathname === getRelativeLocaleUrl(lang, '') ? 'active' : ''}`}
        >
          {t('nav.home')}
        </a>
        <a 
          href={getRelativeLocaleUrl(lang, 'generator')} 
          class={`nav-link ${pathname.includes('generator') ? 'active' : ''}`}
        >
          {t('nav.generator')}
        </a>
        <a 
          href={getRelativeLocaleUrl(lang, 'templates')} 
          class={`nav-link ${pathname.includes('templates') ? 'active' : ''}`}
        >
          {t('nav.templates')}
        </a>
        <a 
          href={getRelativeLocaleUrl(lang, 'blog')} 
          class={`nav-link ${pathname.includes('blog') ? 'active' : ''}`}
        >
          {t('nav.blog')}
        </a>
        <a 
          href={getRelativeLocaleUrl(lang, 'about')} 
          class={`nav-link ${pathname.includes('about') ? 'active' : ''}`}
        >
          {t('nav.about')}
        </a>
      </nav>

      <!-- Right Action Group -->
      <div class="nav-actions">
        <LanguagePicker currentLang={lang} currentPath={pathname} />

        <a href={getRelativeLocaleUrl(lang, 'generator')} class="btn btn-primary nav-cta">
          <span>{t('nav.createNow')}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <!-- Mobile Menu Hamburger -->
        <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div class="mobile-menu" id="mobileMenu">
    <a href={getRelativeLocaleUrl(lang, '')} class="mobile-link">{t('nav.home')}</a>
    <a href={getRelativeLocaleUrl(lang, 'generator')} class="mobile-link">{t('nav.generator')}</a>
    <a href={getRelativeLocaleUrl(lang, 'templates')} class="mobile-link">{t('nav.templates')}</a>
    <a href={getRelativeLocaleUrl(lang, 'blog')} class="mobile-link">{t('nav.blog')}</a>
    <a href={getRelativeLocaleUrl(lang, 'about')} class="mobile-link">{t('nav.about')}</a>
    <div class="mobile-cta-wrap">
      <a href={getRelativeLocaleUrl(lang, 'generator')} class="btn btn-primary btn-lg" style="width: 100%;">
        {t('nav.createNow')}
      </a>
    </div>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    background-color: rgba(232, 235, 230, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(14, 15, 12, 0.08);
    z-index: 999;
    padding: var(--spacing-sm) 0;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 54px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-badge {
    width: 40px;
    height: 40px;
    border-radius: var(--rounded-md);
    background: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    box-shadow: var(--shadow-sm);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 900;
    line-height: 1.1;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .logo-sub {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-mute);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .nav-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-body);
    transition: color var(--transition-fast);
    padding: 6px 10px;
    border-radius: var(--rounded-pill);
  }

  .nav-link:hover {
    color: var(--color-ink);
    background: rgba(14, 15, 12, 0.04);
  }

  .nav-link.active {
    color: var(--color-ink);
    background: rgba(14, 15, 12, 0.08);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .nav-cta {
    display: inline-flex;
  }

  .mobile-toggle {
    display: none;
    padding: 8px;
    color: var(--color-ink);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--color-canvas);
    padding: var(--spacing-lg);
    border-top: 1px solid rgba(14, 15, 12, 0.08);
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-link {
    padding: 12px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    border-bottom: 1px solid rgba(14, 15, 12, 0.06);
  }

  .mobile-cta-wrap {
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 900px) {
    .nav-links, .nav-cta {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobileMenuBtn');
    const menu = document.getElementById('mobileMenu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      menu.classList.toggle('open');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
