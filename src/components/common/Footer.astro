---
import { useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import { languages } from '../../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="band-dark site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-col footer-brand-col">
        <div class="footer-logo">
          <span class="logo-icon-footer">📰</span>
          <span class="logo-title-footer">The Vintage Press</span>
        </div>
        <p class="footer-tagline-text">{t('footer.tagline')}</p>
        <div class="footer-badge">
          <span class="badge-pill badge-dark">100% Client-Side Engine</span>
        </div>
      </div>

      <!-- Quick links -->
      <div class="footer-col">
        <h4 class="footer-heading">{t('footer.links')}</h4>
        <ul class="footer-links-list">
          <li><a href={getRelativeLocaleUrl(lang, '')}>{t('nav.home')}</a></li>
          <li><a href={getRelativeLocaleUrl(lang, 'generator')}>{t('nav.generator')}</a></li>
          <li><a href={getRelativeLocaleUrl(lang, 'templates')}>{t('nav.templates')}</a></li>
          <li><a href={getRelativeLocaleUrl(lang, 'blog')}>{t('nav.blog')}</a></li>
          <li><a href={getRelativeLocaleUrl(lang, 'about')}>{t('nav.about')}</a></li>
        </ul>
      </div>

      <!-- Templates & Use cases -->
      <div class="footer-col">
        <h4 class="footer-heading">Presets & Themes</h4>
        <ul class="footer-links-list">
          <li><a href={getRelativeLocaleUrl(lang, 'templates#breaking-1920')}>1920s Broadsheet Scoop</a></li>
          <li><a href={getRelativeLocaleUrl(lang, 'templates#wanted-wild-west')}>Wild West Wanted Poster</a></li>
          <li><a href={getRelativeLocaleUrl(lang, 'templates#moon-landing-1969')}>1969 Apollo Milestone</a></li>
          <li><a href={getRelativeLocaleUrl(lang, 'templates#wedding-extra')}>High Society Nuptials</a></li>
          <li><a href={getRelativeLocaleUrl(lang, 'templates#tabloid-ufo')}>1950s Sci-Fi Tabloid</a></li>
        </ul>
      </div>

      <!-- Languages Supported -->
      <div class="footer-col">
        <h4 class="footer-heading">Languages</h4>
        <div class="footer-lang-grid">
          {Object.entries(languages).map(([code, info]) => (
            <a 
              href={getRelativeLocaleUrl(code as SupportedLanguage, '')}
              class={`footer-lang-pill ${code === lang ? 'active' : ''}`}
            >
              <span>{info.flag}</span>
              <span>{info.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="footer-copy">
        © {currentYear} The Vintage Press. {t('footer.legal')}
      </p>
      <p class="footer-built">
        {t('footer.madeWith')}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-ink);
    color: var(--color-canvas-soft);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.5fr 1.5fr;
    gap: var(--spacing-2xl);
    padding-bottom: var(--spacing-3xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    margin-bottom: var(--spacing-md);
  }

  .logo-title-footer {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 900;
    color: var(--color-canvas);
    font-size: 19px;
  }

  .footer-tagline-text {
    font-size: 14px;
    color: rgba(232, 235, 230, 0.7);
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
    max-width: 320px;
  }

  .footer-heading {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    margin-bottom: var(--spacing-lg);
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links-list a {
    font-size: 14px;
    color: rgba(232, 235, 230, 0.75);
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }

  .footer-links-list a:hover {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  .footer-lang-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .footer-lang-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: var(--rounded-sm);
    background: rgba(255, 255, 255, 0.05);
    font-size: 12px;
    color: rgba(232, 235, 230, 0.8);
    transition: all var(--transition-fast);
  }

  .footer-lang-pill:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-canvas);
  }

  .footer-lang-pill.active {
    background: rgba(159, 232, 112, 0.15);
    color: var(--color-primary);
    border: 1px solid rgba(159, 232, 112, 0.4);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-xl);
    flex-wrap: wrap;
    gap: var(--spacing-md);
    font-size: 13px;
    color: rgba(232, 235, 230, 0.6);
  }
</style>
