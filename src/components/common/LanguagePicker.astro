---
import { languages, type SupportedLanguage } from '../../i18n/ui';

interface Props {
  currentLang: SupportedLanguage;
  currentPath?: string;
}

const { currentLang, currentPath = '' } = Astro.props;

// Helper to construct localized URLs
function getLocalizedUrl(targetLang: string): string {
  // Strip leading locale if present
  let cleanPath = currentPath;
  const segments = currentPath.split('/').filter(Boolean);
  if (segments.length > 0 && segments[0] in languages) {
    cleanPath = '/' + segments.slice(1).join('/');
  }
  if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
  
  if (targetLang === 'en') {
    return cleanPath === '/' ? '/' : cleanPath;
  }
  return cleanPath === '/' ? `/${targetLang}` : `/${targetLang}${cleanPath}`;
}
---

<div class="lang-selector-wrap">
  <button class="lang-btn" id="langDropdownBtn" aria-label="Select Language" aria-expanded="false">
    <span class="lang-flag">{languages[currentLang]?.flag || '🌐'}</span>
    <span class="lang-name">{languages[currentLang]?.label || currentLang.toUpperCase()}</span>
    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="lang-menu" id="langDropdownMenu">
    {Object.entries(languages).map(([code, info]) => {
      const isActive = code === currentLang;
      return (
        <a 
          href={getLocalizedUrl(code)} 
          class={`lang-item ${isActive ? 'active' : ''}`}
          data-lang={code}
        >
          <span class="item-flag">{info.flag}</span>
          <span class="item-label">{info.label}</span>
          {isActive && (
            <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>

<style>
  .lang-selector-wrap {
    position: relative;
    display: inline-block;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--color-canvas);
    border: 1px solid rgba(14, 15, 12, 0.12);
    border-radius: var(--rounded-pill);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
    transition: all var(--transition-fast);
  }

  .lang-btn:hover {
    background: var(--color-canvas-soft);
    border-color: var(--color-ink);
  }

  .chevron-icon {
    transition: transform var(--transition-fast);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 170px;
    background: var(--color-canvas);
    border: 1px solid rgba(14, 15, 12, 0.1);
    border-radius: var(--rounded-md);
    box-shadow: var(--shadow-lg);
    padding: 6px;
    display: none;
    flex-direction: column;
    gap: 2px;
    z-index: 1000;
  }

  .lang-menu.show {
    display: flex;
    animation: fadeIn 0.15s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .lang-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: var(--rounded-sm);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
    transition: background var(--transition-fast);
  }

  .lang-item:hover {
    background: var(--color-canvas-soft);
  }

  .lang-item.active {
    background: var(--color-primary-pale);
    color: var(--color-ink-deep);
    font-weight: 600;
  }

  .check-icon {
    margin-left: auto;
    color: var(--color-positive-deep);
  }
</style>

<script>
  function setupLangDropdown() {
    const btn = document.getElementById('langDropdownBtn');
    const menu = document.getElementById('langDropdownMenu');

    if (!btn || !menu) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('show');
    });

    document.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      menu.classList.remove('show');
    });
  }

  setupLangDropdown();
  document.addEventListener('astro:page-load', setupLangDropdown);
</script>
