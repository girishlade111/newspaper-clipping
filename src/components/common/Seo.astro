---
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  lang?: string;
  author?: string;
  datePublished?: string;
  dateModified?: string;
}

import { languages } from '../../i18n/ui';

const {
  title,
  description,
  image = '/og-image.png',
  article = false,
  lang = 'en',
  author,
  datePublished,
  dateModified,
} = Astro.props;

const siteBase = (Astro.site?.toString() ?? 'https://newspaper-clipping-generator.example.com').replace(/\/$/, '');
const currentPath: string = Astro.url.pathname;
// Strip leading locale prefix so alternates can be rebuilt per locale
const pathWithoutLang = currentPath.replace(/^\/(?:zh|pt-BR|ru|ja|tr|ko|de|es|fr|hi)(?:\/|$)/i, '/');
const cleanSubpath = pathWithoutLang === '/' ? '' : pathWithoutLang;
const canonicalURL = new URL(currentPath, siteBase).toString();
const formattedTitle = title.includes('The Vintage Press') ? title : `${title} | The Vintage Press`;
// Effective dates: Article schema requires datePublished; fall back to build time so fields are never empty
const buildNow = new Date().toISOString();
const effectivePublished = datePublished || buildNow;
const effectiveModified = dateModified || effectivePublished;
const effectiveImage = new URL(image || '/og-image.png', siteBase).toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<!-- Fonts: same strategy as Layout.astro — preload critical stylesheet, lazy-load vintage families -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Plus+Jakarta+Sans:wght@800;900&display=swap"
/>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Plus+Jakarta+Sans:wght@800;900&display=swap"
  rel="stylesheet"
/>
<link
  href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Cinzel:wght@700;900&family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Lora:ital,wght@0,400..700;1,400..700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=Special+Elite&family=UnifrakturMaguntia&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.onload=null;this.setAttribute('media','all')"
/>

<!-- Canonical URL (self-referencing per locale variant) -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternates: bidirectional + x-default, mirrors Layout.astro -->
{Object.entries(languages).map(([key, config]) => {
  const localizedPath = (config as any).subpath
    ? `/${(config as any).subpath}${cleanSubpath ? cleanSubpath : '/'}`
    : `${cleanSubpath || '/'}`;
  return <link rel="alternate" hreflang={(config as any).hreflang} href={`${siteBase}${localizedPath}`} />;
})}
<link rel="alternate" hreflang="x-default" href={`${siteBase}${cleanSubpath || '/'}`} />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={effectiveImage} />
<meta property="og:locale" content={lang} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={formattedTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={effectiveImage} />

<!-- Schema.org JSON-LD -->
{article ? (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": formattedTitle,
    "description": description,
    "url": canonicalURL.toString(),
    "image": effectiveImage,
    "author": { "@type": "Person", "name": author || "The Press Editorial Team" },
    "datePublished": effectivePublished,
    "dateModified": effectiveModified,
    "publisher": {
      "@type": "Organization",
      "name": "The Vintage Press",
      "url": (Astro.site || 'https://newspaper-clipping-generator.example.com').toString(),
    },
    "inLanguage": lang,
  })} />
) : (
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": formattedTitle,
  "description": description,
  "url": canonicalURL.toString(),
  "applicationCategory": "DesignApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
})} />
)}
