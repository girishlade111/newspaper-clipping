---
import { getRelativeLocaleUrl } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  post: any;
  lang: SupportedLanguage;
}

const { post, lang } = Astro.props;
const formattedDate = new Date(post.data.pubDate).toLocaleDateString(lang, {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class="card-content card-hover blog-card">
  <div class="blog-card-header">
    <span class="badge-pill badge-neutral">{post.data.category}</span>
    <time class="font-caption" datetime={post.data.pubDate.toISOString()}>
      {formattedDate}
    </time>
  </div>

  <h3 class="blog-card-title font-display-xs">
    <a href={getRelativeLocaleUrl(lang, `blog/${post.slug}`)}>
      {post.data.title}
    </a>
  </h3>

  <p class="blog-card-desc font-body-sm">
    {post.data.description}
  </p>

  <div class="blog-card-footer">
    <div class="blog-author-info">
      <div class="author-avatar-badge">✍️</div>
      <span class="font-caption" style="font-weight: 600; color: var(--color-ink);">
        {post.data.author}
      </span>
    </div>

    <a href={getRelativeLocaleUrl(lang, `blog/${post.slug}`)} class="read-more-link font-body-sm-strong">
      <span>Read Article</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .blog-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
  }

  .blog-card-title {
    margin-bottom: var(--spacing-sm);
    line-height: 1.25;
  }

  .blog-card-title a {
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .blog-card-title a:hover {
    color: var(--color-ink-deep);
    text-decoration: underline;
  }

  .blog-card-desc {
    color: var(--color-body);
    line-height: 1.5;
    margin-bottom: var(--spacing-lg);
    flex-grow: 1;
  }

  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-md);
    border-top: 1px solid rgba(14, 15, 12, 0.08);
  }

  .blog-author-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .author-avatar-badge {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-canvas-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-ink);
    transition: transform var(--transition-fast);
  }

  .read-more-link:hover {
    transform: translateX(3px);
  }
</style>
