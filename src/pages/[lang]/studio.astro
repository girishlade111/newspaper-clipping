---
import Layout from '../../layouts/Layout.astro';
import StudioApp from '../../components/studio/StudioApp.astro';
import { useTranslations } from '../../i18n/utils';
import { languages, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter(lang => lang !== 'en')
    .map(lang => ({
      params: { lang }
    }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const presetParam = Astro.url.searchParams.get('preset') || Astro.url.searchParams.get('template') || 'times-of-india';
---

<Layout
  title={`${t('studio.title')} — The Vintage Press`}
  description={t('studio.subtitle')}
  lang={lang}
>
  <main class="bg-canvas-soft min-h-[calc(100vh-80px)] py-4 sm:py-8">
    <StudioApp lang={lang} initialPresetId={presetParam} />
  </main>
</Layout>
