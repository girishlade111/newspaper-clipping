---
import Layout from '../../layouts/Layout.astro';
import GeneratorApp from '../../components/generator/GeneratorApp.astro';
import { useTranslations } from '../../i18n/utils';
import { languages, defaultLang, type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter(lang => lang !== 'en')
    .map(lang => ({
      params: { lang }
    }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const activeLang = (lang in languages ? lang : defaultLang) as SupportedLanguage;
const t = useTranslations(activeLang);

// Helper to construct localized URLs
function getLocaleUrl(targetLang: string, path = ''): string {
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  if (targetLang === 'en') {
    return cleanPath ? `/${cleanPath}` : '/';
  }
  const sub = languages[targetLang as SupportedLanguage]?.subpath || targetLang;
  return cleanPath ? `/${sub}/${cleanPath}` : `/${sub}/`;
}

// FAQ Schema Markup Data for Technical SEO (JSON-LD)
const faqList = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
  { q: t('faq.q6'), a: t('faq.a6') },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout
  title={`${t('hero.title')} — The Vintage Press`}
  description={t('hero.subtitle')}
  lang={activeLang}
  hideHeader={true}
  hideFooter={true}
>
  <!-- 5. Technical SEO: FAQ Schema Markup injected into <head> -->
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <!-- 1. Top Navigation Bar strictly adhering to DESIGN.md -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-black/10 transition-colors">
    <div class="max-w-[1240px] mx-auto px-6 h-16 flex items-center justify-between">
      <!-- Brand Logo -->
      <a href={getLocaleUrl(activeLang)} class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center font-black text-ink text-sm shadow-sm transition-transform group-hover:scale-105">
          VP
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-lg tracking-tight text-ink font-display leading-tight">
            The Vintage Press
          </span>
          <span class="text-[10px] font-bold uppercase tracking-wider text-mute">
            Clipping Studio
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-ink">
        <a href={getLocaleUrl(activeLang)} class="hover:text-black/70 transition-colors">
          {t('nav.home')}
        </a>
        <a href="#how-it-works" class="hover:text-black/70 transition-colors">
          {t('how.title')}
        </a>
        <a href="#use-cases" class="hover:text-black/70 transition-colors">
          {t('usecases.title')}
        </a>
        <a href="#faq" class="hover:text-black/70 transition-colors">
          {t('faq.title')}
        </a>
        <a href={getLocaleUrl(activeLang, 'blog')} class="hover:text-black/70 transition-colors">
          {t('nav.blog')}
        </a>
      </nav>

      <!-- Right Action Group: Language Switcher Dropdown + 24px Pill CTA -->
      <div class="flex items-center gap-3">
        <!-- Language Switcher Dropdown -->
        <div class="relative" id="langSwitcherDropdown">
          <button
            type="button"
            class="inline-flex items-center gap-2 h-10 px-3.5 rounded-pill bg-canvas-soft hover:bg-[#dbe0d8] text-ink font-semibold text-xs border border-black/10 transition-colors"
            id="langMenuBtn"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span class="text-sm">{languages[activeLang]?.flag || '🌐'}</span>
            <span class="hidden sm:inline font-bold">{languages[activeLang]?.label || activeLang.toUpperCase()}</span>
            <svg class="w-3 h-3 text-ink/70 transition-transform duration-200" id="langChevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div
            class="absolute right-0 mt-2 w-48 py-2 bg-white rounded-xl shadow-xl border border-black/10 hidden z-50 transition-all"
            id="langMenuList"
            role="menu"
          >
            <div class="px-3 py-1 text-[11px] font-bold text-mute uppercase tracking-wider border-b border-black/5 mb-1">
              {t('nav.language')}
            </div>
            {Object.entries(languages).map(([code, info]) => {
              const isCurrent = code === activeLang;
              return (
                <a
                  href={getLocaleUrl(code)}
                  class={`flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold transition-colors ${
                    isCurrent ? 'bg-primary-pale text-ink-deep font-bold' : 'text-ink hover:bg-canvas-soft'
                  }`}
                  role="menuitem"
                >
                  <span class="text-sm">{info.flag}</span>
                  <span class="flex-1">{info.label}</span>
                  {isCurrent && (
                    <svg class="w-3.5 h-3.5 text-positive-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  )}
                </a>
              );
            })}
          </div>
        </div>

        <!-- "Create Clipping" Primary CTA Button (DESIGN.md 24px pill) -->
        <a
          href="#studio"
          class="inline-flex items-center justify-center h-10 sm:h-12 px-5 sm:px-6 rounded-xl bg-primary hover:bg-primary-active text-ink font-semibold text-sm sm:text-base shadow-sm transition-all duration-150 transform hover:-translate-y-0.5"
        >
          {t('nav.create')}
        </a>
      </div>
    </div>
  </header>

  <!-- 2. Hero Section adhering strictly to DESIGN.md -->
  <section class="hero-band bg-canvas-soft pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-black/5">
    <div class="max-w-[1240px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Headline & Copy -->
        <div class="lg:col-span-7 flex flex-col items-start">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-pill bg-primary-pale text-ink-deep font-semibold text-xs tracking-wide uppercase mb-6 border border-primary/30">
            <span class="w-2 h-2 rounded-full bg-positive"></span>
            {t('hero.badge')}
          </div>

          <h1 class="font-display font-black text-ink text-4xl sm:text-5xl lg:text-[64px] leading-[1.05] tracking-tight mb-6">
            {t('hero.title')}
          </h1>

          <p class="font-body text-body text-base sm:text-lg lg:text-xl leading-relaxed mb-8 max-w-xl">
            {t('hero.subtitle')}
          </p>

          <!-- Dual CTA Buttons adhering to DESIGN.md -->
          <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
            <a
              href="#studio"
              class="btn-primary w-full sm:w-auto inline-flex items-center justify-center gap-2.5 h-12 px-7 rounded-xl font-semibold text-base transition-all duration-150 shadow-md transform hover:-translate-y-0.5"
            >
              <span>{t('hero.ctaPrimary')}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href="#how-it-works"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 h-12 px-6 rounded-xl bg-white hover:bg-canvas-soft text-ink font-semibold text-base border border-black/15 transition-colors"
            >
              <span>{t('hero.ctaSecondary')}</span>
            </a>
          </div>

          <!-- Trust Badges & Stats -->
          <div class="flex items-center gap-8 mt-10 pt-8 border-t border-black/10 text-xs text-mute font-semibold">
            <div>
              <span class="font-black text-ink text-base block font-display">500,000+</span>
              <span>{t('hero.statsClippings')}</span>
            </div>
            <div class="w-px h-8 bg-black/10"></div>
            <div>
              <span class="font-black text-ink text-base block font-display">4.9 / 5.0</span>
              <span>{t('hero.statsRating')} ★★★★★</span>
            </div>
            <div class="w-px h-8 bg-black/10"></div>
            <div>
              <span class="font-black text-ink text-base block font-display">100% Free</span>
              <span>Client-Side & Zero Tracking</span>
            </div>
          </div>
        </div>

        <!-- Hero Visual Section Holding hero-image.jpg / hero-image.png -->
        <div class="lg:col-span-5 relative">
          <div class="card-content bg-white p-3 sm:p-4 rounded-xl shadow-xl border border-black/10 relative transform hover:scale-[1.01] transition-transform duration-200">
            <div class="relative overflow-hidden rounded-lg bg-canvas-soft aspect-[4/3] sm:aspect-auto">
              <picture>
                <source srcset="/hero-image.png" type="image/png" />
                <source srcset="/hero-image.jpg" type="image/jpeg" />
                <img
                  src="/hero-image.png"
                  alt={t('hero.imageAlt')}
                  class="w-full h-auto object-cover rounded-lg shadow-inner"
                  loading="eager"
                  width="700"
                  height="500"
                />
              </picture>
            </div>

            <!-- Floating Proof Pill Badge -->
            <div class="absolute -bottom-4 right-6 bg-ink text-white px-4 py-2 rounded-pill shadow-lg text-xs font-bold flex items-center gap-2 border border-white/20">
              <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
              <span>Authentic 1920s Newsprint 4K</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Studio Generator Workspace Anchor -->
  <section class="band-sage bg-canvas-soft py-12 md:py-16 border-b border-black/5" id="studio">
    <div class="max-w-[1240px] mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="inline-flex items-center px-3 py-1 rounded-pill bg-primary text-ink font-bold text-xs uppercase tracking-wider mb-2">
          {t('nav.create')}
        </span>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-ink tracking-tight mb-3">
          {t('nav.generator')}
        </h2>
        <p class="font-body text-body text-sm sm:text-base">
          {t('hero.subtitle')}
        </p>
      </div>

      <!-- Live Generator Component -->
      <div class="card-content bg-white rounded-xl shadow-lg p-4 sm:p-8 border border-black/10">
        <GeneratorApp lang={activeLang} />
      </div>
    </div>
  </section>

  <!-- 3. How It Works Section: 3-Step Grid Layout strictly matching DESIGN.md -->
  <section class="band-white bg-white py-16 md:py-24 border-b border-black/5" id="how-it-works">
    <div class="max-w-[1240px] mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="inline-flex items-center px-3.5 py-1.5 rounded-pill bg-canvas-soft text-ink font-bold text-xs uppercase tracking-wider mb-3">
          {t('how.badge')}
        </span>
        <h2 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-ink tracking-tight mb-4">
          {t('how.title')}
        </h2>
        <p class="font-body text-body text-base sm:text-lg">
          {t('how.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Step 1 -->
        <div class="card-content bg-canvas-soft rounded-xl p-8 border border-black/5 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-xl bg-ink text-primary flex items-center justify-center font-display font-black text-xl mb-6 shadow-sm">
              {t('how.step1.num')}
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-3 leading-snug">
              {t('how.step1.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('how.step1.desc')}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-black/10 flex items-center gap-2 text-xs font-semibold text-mute">
            <span class="text-primary font-bold">✓</span>
            <span>Custom Linotype Columns</span>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="card-content bg-canvas-soft rounded-xl p-8 border border-black/5 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-xl bg-ink text-primary flex items-center justify-center font-display font-black text-xl mb-6 shadow-sm">
              {t('how.step2.num')}
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-3 leading-snug">
              {t('how.step2.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('how.step2.desc')}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-black/10 flex items-center gap-2 text-xs font-semibold text-mute">
            <span class="text-primary font-bold">✓</span>
            <span>Real Halftone Shaders</span>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="card-content bg-canvas-soft rounded-xl p-8 border border-black/5 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-xl bg-primary text-ink flex items-center justify-center font-display font-black text-xl mb-6 shadow-sm">
              {t('how.step3.num')}
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-3 leading-snug">
              {t('how.step3.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('how.step3.desc')}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-black/10 flex items-center gap-2 text-xs font-semibold text-mute">
            <span class="text-positive font-bold">✓</span>
            <span>300 DPI Ultra HD PNG</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Use Cases Section Highlighting school projects, memes, and pranks using usecase-image.jpg -->
  <section class="band-sage bg-canvas-soft py-16 md:py-24 border-b border-black/5" id="use-cases">
    <div class="max-w-[1240px] mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="inline-flex items-center px-3.5 py-1.5 rounded-pill bg-primary-pale text-ink-deep font-bold text-xs uppercase tracking-wider mb-3">
          {t('usecases.badge')}
        </span>
        <h2 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-ink tracking-tight mb-4">
          {t('usecases.title')}
        </h2>
        <p class="font-body text-body text-base sm:text-lg">
          {t('usecases.subtitle')}
        </p>
      </div>

      <!-- Use Cases Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- 3 Distinct Feature Cards (School, Memes, Pranks) -->
        <div class="lg:col-span-6 flex flex-col gap-6">
          <!-- 1. School Projects -->
          <div class="card-content bg-white rounded-xl p-6 sm:p-7 border border-black/10 shadow-sm hover:border-black/30 transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="px-3 py-1 rounded-pill bg-canvas-soft text-ink font-bold text-xs uppercase">
                {t('usecases.school.tag')}
              </span>
              <span class="text-lg">🎓</span>
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-2">
              {t('usecases.school.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('usecases.school.desc')}
            </p>
          </div>

          <!-- 2. Memes & Viral Parodies -->
          <div class="card-content bg-white rounded-xl p-6 sm:p-7 border border-black/10 shadow-sm hover:border-black/30 transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="px-3 py-1 rounded-pill bg-primary-pale text-positive-deep font-bold text-xs uppercase">
                {t('usecases.memes.tag')}
              </span>
              <span class="text-lg">🔥</span>
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-2">
              {t('usecases.memes.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('usecases.memes.desc')}
            </p>
          </div>

          <!-- 3. Novelty Gifts & Harmless Pranks -->
          <div class="card-content bg-white rounded-xl p-6 sm:p-7 border border-black/10 shadow-sm hover:border-black/30 transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="px-3 py-1 rounded-pill bg-canvas-soft text-ink font-bold text-xs uppercase">
                {t('usecases.pranks.tag')}
              </span>
              <span class="text-lg">🎉</span>
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-2">
              {t('usecases.pranks.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('usecases.pranks.desc')}
            </p>
          </div>
        </div>

        <!-- Visual Proof Showcase using usecase-image.jpg / usecase-image.png -->
        <div class="lg:col-span-6">
          <div class="card-content bg-white rounded-xl p-4 shadow-xl border border-black/10">
            <div class="overflow-hidden rounded-lg bg-canvas-soft">
              <picture>
                <source srcset="/usecase-image.png" type="image/png" />
                <source srcset="/usecase-image.jpg" type="image/jpeg" />
                <img
                  src="/usecase-image.png"
                  alt={t('usecases.imageAlt')}
                  class="w-full h-auto object-cover rounded-lg shadow-inner transform hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  width="700"
                  height="520"
                />
              </picture>
            </div>
            <div class="mt-4 px-2 flex items-center justify-between text-xs text-mute font-semibold">
              <span>Authentic Headline & Halftone Proof</span>
              <span class="text-positive font-bold">100% Client-Side Render</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ Section with Native <details> and <summary> Accordion strictly matching DESIGN.md -->
  <section class="band-white bg-white py-16 md:py-24 border-b border-black/5" id="faq">
    <div class="max-w-[860px] mx-auto px-6">
      <div class="text-center mb-14">
        <span class="inline-flex items-center px-3.5 py-1.5 rounded-pill bg-canvas-soft text-ink font-bold text-xs uppercase tracking-wider mb-3">
          {t('faq.badge')}
        </span>
        <h2 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-ink tracking-tight mb-4">
          {t('faq.title')}
        </h2>
        <p class="font-body text-body text-base sm:text-lg">
          {t('faq.subtitle')}
        </p>
      </div>

      <!-- Accordion FAQ Items using <details> & <summary> -->
      <div class="flex flex-col gap-4">
        {faqList.map((item, idx) => (
          <details
            class="group card-content bg-canvas-soft rounded-xl p-6 border border-black/10 transition-all duration-150 open:bg-white open:shadow-md"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between cursor-pointer list-none font-display font-bold text-lg sm:text-xl text-ink select-none gap-4">
              <span>{item.q}</span>
              <span class="w-8 h-8 rounded-full bg-white group-open:bg-primary flex items-center justify-center shrink-0 text-ink shadow-sm transition-transform duration-200 group-open:rotate-45">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 pt-4 border-t border-black/10 font-body text-body text-sm sm:text-base leading-relaxed">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Global Dark Footer Band adhering strictly to DESIGN.md -->
  <footer class="band-dark bg-ink text-canvas-soft pt-16 pb-12 px-6">
    <div class="max-w-[1240px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
        <!-- Brand Info -->
        <div class="md:col-span-5 flex flex-col items-start">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-xl bg-primary flex items-center justify-center font-black text-ink text-sm shadow-sm">
              VP
            </div>
            <span class="font-extrabold text-xl tracking-tight text-white font-display">
              The Vintage Press
            </span>
          </div>
          <p class="text-sm text-canvas-soft/75 leading-relaxed max-w-sm mb-6">
            {t('footer.tagline')}
          </p>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-pill bg-white/10 text-primary text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span>100% Serverless & Lifetime Free</span>
          </div>
        </div>

        <!-- Quick Links: Blog, Privacy Policy, Terms -->
        <div class="md:col-span-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-primary mb-4">
            {t('footer.links')}
          </h4>
          <ul class="flex flex-col gap-2.5 text-sm font-medium">
            <li>
              <a href={getLocaleUrl(activeLang, 'blog')} class="text-canvas-soft/80 hover:text-white transition-colors">
                {t('footer.blog')}
              </a>
            </li>
            <li>
              <a href={getLocaleUrl(activeLang, 'privacy')} class="text-canvas-soft/80 hover:text-white transition-colors">
                {t('footer.privacy')}
              </a>
            </li>
            <li>
              <a href={getLocaleUrl(activeLang, 'terms')} class="text-canvas-soft/80 hover:text-white transition-colors">
                {t('footer.terms')}
              </a>
            </li>
            <li>
              <a href={getLocaleUrl(activeLang, 'templates')} class="text-canvas-soft/80 hover:text-white transition-colors">
                {t('nav.templates')}
              </a>
            </li>
          </ul>
        </div>

        <!-- Language Directory -->
        <div class="md:col-span-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-primary mb-4">
            {t('nav.language')}
          </h4>
          <div class="grid grid-cols-2 gap-2 text-xs">
            {Object.entries(languages).map(([code, info]) => (
              <a
                href={getLocaleUrl(code)}
                class={`flex items-center gap-2 px-2.5 py-1.5 rounded-lg border transition-colors ${
                  code === activeLang
                    ? 'border-primary bg-primary/10 text-primary font-bold'
                    : 'border-white/10 hover:border-white/30 text-canvas-soft/80 hover:text-white'
                }`}
              >
                <span>{info.flag}</span>
                <span>{info.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Bottom Copyright & Legal Note -->
      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute">
        <p>
          © {new Date().getFullYear()} The Vintage Press. {t('footer.legal')}
        </p>
        <p>
          {t('footer.rights')}
        </p>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Interactive Language Switcher Toggle
  function setupLangDropdown() {
    const btn = document.getElementById('langMenuBtn');
    const menu = document.getElementById('langMenuList');
    const chevron = document.getElementById('langChevron');
    if (!btn || !menu) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      if (chevron) {
        chevron.classList.toggle('rotate-180');
      }
    });

    document.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
      if (chevron) {
        chevron.classList.remove('rotate-180');
      }
    });
  }

  setupLangDropdown();
  document.addEventListener('astro:page-load', setupLangDropdown);
</script>
