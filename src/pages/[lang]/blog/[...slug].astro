---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, getRelativeLocaleUrl } from '../../../i18n/utils';
import { languages, type SupportedLanguage } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const paths: any[] = [];

  for (const post of posts) {
    const lang = post.data.language;
    if (lang !== 'en') {
      const slug = post.slug.replace(new RegExp(`^${lang}/`), '');
      paths.push({
        params: { lang, slug },
        props: { post }
      });
    }
  }

  return paths;
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const { post } = Astro.props;
const { Content } = await post.render();
const t = useTranslations(lang);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout
  title={`${post.data.title} — The Vintage Press`}
  description={post.data.description}
  article={true}
  lang={lang}
>
  <article class="band-sage article-hero-band">
    <div class="container-narrow">
      <div class="article-meta-top">
        <a href={getRelativeLocaleUrl(lang, 'blog')} class="back-link font-body-sm-strong">
          {t('blog.backToBlog')}
        </a>
        <span class="badge-pill badge-neutral">{post.data.category}</span>
      </div>

      <h1 class="font-display-lg article-main-title">{post.data.title}</h1>

      <p class="font-body-lg article-lead-description">{post.data.description}</p>

      <div class="article-author-row">
        <div class="author-avatar-badge">✍️</div>
        <div>
          <strong class="font-body-md-strong" style="display: block;">{post.data.author}</strong>
          <time class="font-caption" datetime={post.data.pubDate.toISOString()}>
            {t('blog.publishedOn')} {formattedDate}
          </time>
        </div>
      </div>
    </div>
  </article>

  <div class="band-white article-content-band">
    <div class="container-narrow">
      <div class="prose-content">
        <Content />
      </div>

      <div class="article-cta-box card-feature-sage" style="margin-top: var(--spacing-3xl);">
        <div>
          <h3 class="font-display-xs" style="margin-bottom: 4px;">{t('hero.title')}</h3>
          <p class="font-body-md">{t('hero.subtitle')}</p>
        </div>
        <a href={getRelativeLocaleUrl(lang, 'generator')} class="btn btn-primary">
          <span>{t('hero.ctaPrimary')} →</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .article-hero-band {
    padding-top: var(--spacing-3xl);
    padding-bottom: var(--spacing-3xl);
    border-bottom: 1px solid rgba(14, 15, 12, 0.08);
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-lg);
  }

  .back-link {
    color: var(--color-ink);
    transition: transform var(--transition-fast);
  }

  .back-link:hover {
    transform: translateX(-3px);
  }

  .article-main-title {
    margin-bottom: var(--spacing-md);
    line-height: 1.15;
  }

  .article-lead-description {
    color: var(--color-body);
    margin-bottom: var(--spacing-xl);
    line-height: 1.5;
  }

  .article-author-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: var(--spacing-md);
    border-top: 1px solid rgba(14, 15, 12, 0.1);
  }

  .author-avatar-badge {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-canvas);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    box-shadow: var(--shadow-sm);
  }

  .article-content-band {
    padding-top: var(--spacing-3xl);
    padding-bottom: var(--spacing-4xl);
  }

  .prose-content {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-ink);
  }

  .prose-content :global(h2) {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    margin-top: 2em;
    margin-bottom: 0.6em;
  }

  .prose-content :global(p) {
    margin-bottom: 1.4em;
  }

  .prose-content :global(ul) {
    margin-bottom: 1.4em;
    padding-left: 1.5em;
  }

  .prose-content :global(li) {
    margin-bottom: 0.5em;
  }

  .article-cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
  }
</style>
