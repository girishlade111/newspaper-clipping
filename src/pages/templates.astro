---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRESETS } from '../scripts/presets';
import { getRelativeLocaleUrl } from '../i18n/utils';

const lang = 'en';
---

<BaseLayout
  title="Newspaper Templates & Presets Library — The Vintage Press"
  description="Explore our complete collection of historical broadsheet, wanted poster, wedding announcement, and tabloid newspaper clipping presets."
  lang={lang}
>
  <section class="band-sage" style="padding-top: var(--spacing-3xl); padding-bottom: var(--spacing-4xl);">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--spacing-3xl);">
        <span class="badge-pill badge-brand">Curated Templates</span>
        <h1 class="font-display-lg" style="margin-top: 8px;">Historic Broadsheet Templates</h1>
        <p class="font-body-lg" style="max-width: 640px; margin: 8px auto 0;">
          Select any historic template to load directly into the studio with one click.
        </p>
      </div>

      <div class="grid-2">
        {PRESETS.map((preset) => (
          <div class="card-content card-hover" id={preset.id} style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="template-header-bar">
                <span class="badge-pill badge-neutral">{preset.category}</span>
                <span class="font-caption" style="font-weight: 600;">{preset.date}</span>
              </div>

              <div class="template-paper-box">
                <div class="template-box-masthead">{preset.newspaperName}</div>
                <div class="template-box-tagline">{preset.tagline}</div>
                <div class="template-box-bar">
                  <span>{preset.issue}</span>
                  <span>{preset.price}</span>
                </div>
                <h3 class="template-box-headline">{preset.headline}</h3>
                <p class="template-box-sub">{preset.subheadline}</p>
                <div class="template-box-byline">— {preset.author} —</div>
              </div>
            </div>

            <div style="margin-top: var(--spacing-lg);">
              <a 
                href={getRelativeLocaleUrl(lang, `generator?preset=${preset.id}`)} 
                class="btn btn-primary" 
                style="width: 100%;"
              >
                <span>Customize in Studio →</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .text-center {
    text-align: center;
  }

  .template-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
  }

  .template-paper-box {
    background: #ede0cb;
    border: 1px solid #cebe9e;
    border-radius: var(--rounded-md);
    padding: 24px;
    color: #171411;
    box-shadow: inset 0 0 12px rgba(0, 0, 0, 0.04);
  }

  .template-box-masthead {
    font-family: var(--font-newspaper-gothic);
    font-size: 26px;
    text-align: center;
    line-height: 1.1;
  }

  .template-box-tagline {
    font-size: 9px;
    font-style: italic;
    text-align: center;
    color: #4a3e30;
    margin-bottom: 6px;
  }

  .template-box-bar {
    display: flex;
    justify-content: space-between;
    font-size: 8px;
    font-weight: 700;
    border-top: 1px solid #171411;
    border-bottom: 1px solid #171411;
    padding: 3px 0;
    margin-bottom: 10px;
  }

  .template-box-headline {
    font-family: var(--font-newspaper-serif);
    font-size: 15px;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 6px;
  }

  .template-box-sub {
    font-family: var(--font-newspaper-serif);
    font-size: 11px;
    font-style: italic;
    text-align: center;
    color: #3b3328;
    margin-bottom: 8px;
  }

  .template-box-byline {
    font-size: 8.5px;
    font-weight: 700;
    text-align: center;
    color: #554839;
  }
</style>
