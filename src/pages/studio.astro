---
import Layout from '../layouts/Layout.astro';
import StudioIsland from '../components/studio/StudioIsland';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const presetParam = Astro.url.searchParams.get('preset') || Astro.url.searchParams.get('template') || 'times-of-india';
---

<Layout
  title={`${t('studio.title')} — The Vintage Press`}
  description={t('studio.subtitle')}
  lang={lang}
>
  <main class="bg-canvas-soft min-h-[calc(100vh-80px)] py-4 sm:py-8">
    <StudioIsland client:load lang={lang} initialTemplate={presetParam} />
  </main>
</Layout>
