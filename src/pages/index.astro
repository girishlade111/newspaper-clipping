---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const studioUrl = '/studio';

// FAQ list for rendering and technical SEO schema markup
const faqList = [
  { q: t('home.faq.q1'), a: t('home.faq.a1') },
  { q: t('home.faq.q2'), a: t('home.faq.a2') },
  { q: t('home.faq.q3'), a: t('home.faq.a3') },
  { q: t('home.faq.q4'), a: t('home.faq.a4') },
  { q: t('home.faq.q5'), a: t('home.faq.a5') },
  { q: t('home.faq.q6'), a: t('home.faq.a6') },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout
  title={`${t('home.hero.title')} — The Vintage Press`}
  description={t('home.hero.description')}
  lang={lang}
>
  <!-- SEO: FAQ Schema Markup injected into head -->
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <!-- 1. HERO SECTION (Adhering strictly to DESIGN.md Sage Canvas Band) -->
  <section class="bg-canvas-soft py-12 md:py-20 lg:py-24 border-b border-black/5 overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left: Catchy Headline, Description & Primary CTA -->
        <div class="lg:col-span-7 flex flex-col items-start">
          <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/80 text-ink-deep border border-black/5 shadow-xs mb-4">
            {t('home.hero.badge')}
          </span>

          <h1 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl text-ink leading-[1.08] tracking-tight mb-6">
            {t('home.hero.title')}
          </h1>

          <p class="font-body text-body text-base sm:text-lg lg:text-xl leading-relaxed mb-8 max-w-2xl">
            {t('home.hero.description')}
          </p>

          <!-- Primary CTA Button: Canonical Wise Lime-Green 24px Pill Button linking to /studio -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
            <a
              href={studioUrl}
              class="inline-flex items-center justify-center h-12 px-8 rounded-xl bg-primary hover:bg-primary-active text-ink font-semibold text-base transition-all duration-150 transform hover:-translate-y-0.5 shadow-sm whitespace-nowrap group"
            >
              <span>{t('home.hero.cta')}</span>
              <svg class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <!-- Social Proof / Stats Strip -->
          <div class="flex items-center gap-6 sm:gap-8 mt-10 pt-6 border-t border-black/10 text-xs text-mute font-semibold">
            <div>
              <span class="block text-ink font-black text-lg sm:text-xl leading-tight">100,000+</span>
              <span>{t('home.hero.statsClippings')}</span>
            </div>
            <div class="w-px h-8 bg-black/10"></div>
            <div>
              <span class="block text-ink font-black text-lg sm:text-xl leading-tight">4.9 / 5.0</span>
              <span>{t('home.hero.statsRating')}</span>
            </div>
          </div>
        </div>

        <!-- Right: Authentic Hero Media (Exact local path /images/hero-image.jpg) -->
        <div class="lg:col-span-5 w-full flex justify-center">
          <div class="relative w-full max-w-md lg:max-w-none rounded-2xl overflow-hidden shadow-2xl border border-black/10 bg-white">
            <img 
              src="/images/hero-image.jpg" 
              alt={t('home.hero.imageAlt')} 
              class="w-full h-auto object-cover block"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. HOW IT WORKS SECTION (3 Simple Steps explaining the tool) -->
  <section class="bg-white py-16 md:py-24 border-b border-black/5" id="how-it-works">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-primary-pale text-ink-deep border border-black/5 shadow-xs mb-3">
          {t('home.how.badge')}
        </span>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-ink tracking-tight mb-4">
          {t('home.how.title')}
        </h2>
        <p class="font-body text-body text-base sm:text-lg leading-relaxed">
          {t('home.how.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <!-- Step 1 -->
        <div class="bg-canvas-soft rounded-xl p-6 sm:p-8 border border-black/5 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="text-3xl sm:text-4xl font-black font-display text-primary-deep/40 mb-4">
              {t('home.how.step1.num')}
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-3 leading-snug">
              {t('home.how.step1.title')}
            </h3>
            <p class="font-body text-body text-sm sm:text-base leading-relaxed">
              {t('home.how.step1.desc')}
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="bg-canvas-soft rounded-xl p-6 sm:p-8 border border-black/5 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="text-3xl sm:text-4xl font-black font-display text-primary-deep/40 mb-4">
              {t('home.how.step2.num')}
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-3 leading-snug">
              {t('home.how.step2.title')}
            </h3>
            <p class="font-body text-body text-sm sm:text-base leading-relaxed">
              {t('home.how.step2.desc')}
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="bg-canvas-soft rounded-xl p-6 sm:p-8 border border-black/5 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="text-3xl sm:text-4xl font-black font-display text-primary-deep/40 mb-4">
              {t('home.how.step3.num')}
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-3 leading-snug">
              {t('home.how.step3.title')}
            </h3>
            <p class="font-body text-body text-sm sm:text-base leading-relaxed">
              {t('home.how.step3.desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Centered CTA under steps -->
      <div class="text-center mt-12">
        <a
          href={studioUrl}
          class="inline-flex items-center justify-center h-12 px-8 rounded-xl bg-primary hover:bg-primary-active text-ink font-semibold text-base transition-all duration-150 transform hover:-translate-y-0.5 shadow-sm whitespace-nowrap"
        >
          <span>{t('home.hero.cta')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. USE CASES SECTION (Practical Uses: Memes, School Projects, Milestones) -->
  <section class="bg-canvas-soft py-16 md:py-24 border-b border-black/5" id="use-cases">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left: Use Case Content Cards -->
        <div class="lg:col-span-7 flex flex-col space-y-6">
          <div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white text-ink-deep border border-black/5 shadow-xs mb-3">
              {t('home.usecases.badge')}
            </span>
            <h2 class="font-display font-black text-3xl sm:text-4xl text-ink tracking-tight mb-4">
              {t('home.usecases.title')}
            </h2>
            <p class="font-body text-body text-base sm:text-lg leading-relaxed mb-6">
              {t('home.usecases.subtitle')}
            </p>
          </div>

          <!-- Feature Item 1: School & History -->
          <div class="bg-white rounded-xl p-5 sm:p-6 border border-black/5 shadow-xs">
            <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-primary-pale text-ink-deep mb-2">
              {t('home.usecases.school.tag')}
            </span>
            <h3 class="font-display font-bold text-lg text-ink mb-1.5">
              {t('home.usecases.school.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('home.usecases.school.desc')}
            </p>
          </div>

          <!-- Feature Item 2: Memes & Social -->
          <div class="bg-white rounded-xl p-5 sm:p-6 border border-black/5 shadow-xs">
            <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-accent-orange/30 text-ink mb-2">
              {t('home.usecases.memes.tag')}
            </span>
            <h3 class="font-display font-bold text-lg text-ink mb-1.5">
              {t('home.usecases.memes.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('home.usecases.memes.desc')}
            </p>
          </div>

          <!-- Feature Item 3: Novelty & Celebration -->
          <div class="bg-white rounded-xl p-5 sm:p-6 border border-black/5 shadow-xs">
            <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-accent-cyan/30 text-ink mb-2">
              {t('home.usecases.pranks.tag')}
            </span>
            <h3 class="font-display font-bold text-lg text-ink mb-1.5">
              {t('home.usecases.pranks.title')}
            </h3>
            <p class="font-body text-body text-sm leading-relaxed">
              {t('home.usecases.pranks.desc')}
            </p>
          </div>

          <div>
            <a
              href={studioUrl}
              class="inline-flex items-center justify-center h-12 px-8 rounded-xl bg-primary hover:bg-primary-active text-ink font-semibold text-base transition-all duration-150 transform hover:-translate-y-0.5 shadow-sm whitespace-nowrap"
            >
              <span>{t('home.usecases.cta')}</span>
            </a>
          </div>
        </div>

        <!-- Right: Use Case Media Showcase (Exact local path /images/usecase-image.jpg) -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md lg:max-w-none rounded-2xl overflow-hidden shadow-2xl border border-black/10 bg-white">
            <img 
              src="/images/usecase-image.jpg" 
              alt={t('home.usecases.imageAlt')} 
              class="w-full h-auto object-cover block"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. FAQ SECTION (Accordion style using <details> for SEO) -->
  <section class="bg-white py-16 md:py-24 border-b border-black/5" id="faq">
    <div class="max-w-[860px] mx-auto px-4 sm:px-6">
      <div class="text-center mb-12 sm:mb-16">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-canvas-soft text-ink-deep border border-black/5 shadow-xs mb-3">
          {t('home.faq.badge')}
        </span>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-ink tracking-tight mb-4">
          {t('home.faq.title')}
        </h2>
        <p class="font-body text-body text-base sm:text-lg leading-relaxed">
          {t('home.faq.subtitle')}
        </p>
      </div>

      <!-- FAQ Accordions with <details> -->
      <div class="space-y-4">
        {faqList.map((item) => (
          <details class="group bg-canvas-soft/60 hover:bg-canvas-soft rounded-2xl border border-black/10 transition-colors overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-5 sm:p-6 font-semibold text-ink select-none list-none font-display text-base sm:text-lg">
              <span class="pr-4">{item.q}</span>
              <svg class="w-5 h-5 text-ink/70 transition-transform duration-200 group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-5 pb-5 sm:px-6 sm:pb-6 text-body text-sm sm:text-base leading-relaxed border-t border-black/5 pt-3">
              {item.a}
            </div>
          </details>
        ))}
      </div>

      <!-- Final Bottom Call to Action -->
      <div class="mt-16 text-center bg-canvas-soft rounded-2xl p-8 sm:p-12 border border-black/10">
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-ink mb-3">
          {t('home.hero.title')}
        </h3>
        <p class="font-body text-body text-sm sm:text-base max-w-xl mx-auto mb-6">
          {t('home.hero.description')}
        </p>
        <a
          href={studioUrl}
          class="inline-flex items-center justify-center h-12 px-8 rounded-xl bg-primary hover:bg-primary-active text-ink font-semibold text-base transition-all duration-150 transform hover:-translate-y-0.5 shadow-sm whitespace-nowrap"
        >
          <span>{t('home.hero.cta')}</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
